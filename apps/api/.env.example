# Railway Postgres (or any Postgres). Prisma uses DATABASE_URL at runtime
# and DIRECT_URL for migrations. On Railway you can set both to the same
# public URL, or use the proxy URL for DATABASE_URL and the direct URL for DIRECT_URL.
# Prefer appending ?sslmode=require if connections fail TLS negotiation.
DATABASE_URL="postgresql://user:pass@host:port/railway?sslmode=require"
DIRECT_URL="postgresql://user:pass@host:port/railway?sslmode=require"

PORT=3001
APP_ORIGIN="http://localhost:3002"
# Comma-separated extra frontend origins allowed for SIWE + CORS (www/apex pairs are added automatically).
# APP_ORIGINS="https://www.lnoc.app,https://house-app-eta.vercel.app"
API_ORIGIN="http://localhost:3001"
SESSION_SECRET="generate-with-openssl-rand-hex-32"
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
COOKIE_NAME="house_session"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# v1: the SIWE wallet that becomes SUPERADMIN (must match OPERATOR_PRIVATE_KEY)
SUPERADMIN_WALLET="0x0000000000000000000000000000000000000000"
# Optional. Listings awaiting review are emailed to every SUPERADMIN with a
# verified address; set this to also notify a fixed address — useful before any
# SUPERADMIN has verified an email.
SUPERADMIN_EMAIL=""
OPERATOR_PRIVATE_KEY=""
# Protocol fee + daily-auction winning-bid payout. Operator still starts/ends
# auctions; settlement forwards the owner's share here after endAuction.
FEE_RECIPIENT="0x755Dc65333C16F388d2054513B9D013D7035F230"
ROBINHOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
AUCTION_HOUSE_ADDRESS="0xf976Ca98bA8D2B70E8698e09814a663deABE6359"

RESEND_API_KEY=""
EMAIL_FROM="LNOC <noreply@lnoc.xyz>"
CRON_SECRET=""
# Whole USDG reserve for the operator-started daily auction.
DAILY_AUCTION_MIN_BID="0.01"

# Railway Redis. Caches each bidder's daily-auction project pitch so being
# outbid never makes them re-enter it. Optional — unset falls back to Postgres.
REDIS_URL=""

# S3 uploads (presigned PUT). Avatars and project art under avatar/ and project/
# are public-read; chat attachments under chat/ must NOT be — they are served as
# short-lived presigned GETs to conversation participants only. See S3_SETUP.md
# for the bucket policy that grants public read to the public prefixes alone.
# CORS must allow PUT and GET from the app origin.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# --- LNOC price keeper -------------------------------------------------------
# The AuctionHouse cannot read a market: `_usdToToken` divides by the stored
# `usdPriceE8`, so LNOC's rate has to be published on-chain. The keeper derives
# it from Uniswap v3 pools (LNOC/WETH x WETH/USDG) rather than a price API, so
# no HTTP endpoint sits in the payment path, and writes it with setTokenUsdPrice.
#
# Off by default. Turn it on only once you are happy with the guards below.
LNOC_PRICE_KEEPER="false"

# Pools and token. The defaults are the live Robinhood Chain addresses; override
# only if liquidity moves to a different pool.
# LNOC_TOKEN_ADDRESS="0x076277c3d6b57B4aad34c592cd2f138e9316a991"
# LNOC_WETH_POOL="0x8A22a8A5ea033c0b57d1Ec39C135624cfCB9b8C5"
# WETH_USDG_POOL="0x52e65B17fB6E5BA00Ed806f37Afcd2DaA50271Ca"

# TWAP window. Longer is harder to manipulate but slower to track a real move.
LNOC_TWAP_SECONDS="1800"

# Guards. A move beyond MAX_MOVE_PCT is never published — whether it is
# manipulation or a genuine crash, a human should look first. Refusing leaves the
# previous rate in place, which stays usable while maxAge is 0, so the failure
# mode is slightly stale pricing rather than halted payments.
LNOC_KEEPER_MAX_MOVE_PCT="20"
# Below this, the price is not republished — avoids burning gas on noise.
LNOC_KEEPER_MIN_CHANGE_PCT="1"
# Set true to refuse any spot-derived price. Only useful once the LNOC/WETH pool
# can serve a real TWAP: its observation buffer is 1 today, and a buffer of 1
# makes `observe()` return the spot tick rather than reverting. Grow it with
# `increaseObservationCardinalityNext` (permissionless), then turn this on.
LNOC_KEEPER_REQUIRE_TWAP="false"
# How often a pass may publish, regardless of how often the ticker calls it.
LNOC_KEEPER_INTERVAL_MS="300000"
