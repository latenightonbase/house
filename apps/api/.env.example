# Railway Postgres (or any Postgres). Prisma uses DATABASE_URL at runtime
# and DIRECT_URL for migrations. On Railway you can set both to the same
# public URL, or use the proxy URL for DATABASE_URL and the direct URL for DIRECT_URL.
# Prefer appending ?sslmode=require if connections fail TLS negotiation.
DATABASE_URL="postgresql://user:pass@host:port/railway?sslmode=require"
DIRECT_URL="postgresql://user:pass@host:port/railway?sslmode=require"

PORT=3001
APP_ORIGIN="http://localhost:3002"
API_ORIGIN="http://localhost:3001"
SESSION_SECRET="generate-with-openssl-rand-hex-32"
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
COOKIE_NAME="house_session"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# v1: the SIWE wallet that becomes SUPERADMIN (must match OPERATOR_PRIVATE_KEY)
SUPERADMIN_WALLET="0x0000000000000000000000000000000000000000"
OPERATOR_PRIVATE_KEY=""
ROBINHOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
AUCTION_HOUSE_ADDRESS="0xFfFABB522bB1Ff6F15F505a99c542f57e9378037"

RESEND_API_KEY=""
EMAIL_FROM="LNOC <noreply@lnoc.xyz>"
CRON_SECRET=""
# Whole USDG reserve for the operator-started daily auction.
DAILY_AUCTION_MIN_BID="0.01"

# Railway Redis. Caches each bidder's daily-auction project pitch so being
# outbid never makes them re-enter it. Optional — unset falls back to Postgres.
REDIS_URL=""

# S3 image uploads (presigned PUT). Bucket needs public-read + CORS for the app origin.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
